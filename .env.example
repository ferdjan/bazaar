# ---- Serveur ----
PORT=3000
BASE_URL=http://localhost:3000

# ---- Sécurité session ----
# Génère une valeur aléatoire longue en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Reverse proxy ----
# Mets TRUST_PROXY=1 UNIQUEMENT si l'app est derrière un reverse proxy maîtrisé
# (Render, Nginx, Caddy…). Sinon, un client pourrait forger X-Forwarded-For.
TRUST_PROXY=0

# ---- Compte admin semé (à changer après première connexion) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---- Devise ----
# 1 DZD = X EUR (taux indicatif : ~0.0045). Ajuste selon le taux réel.
DZD_TO_EUR_RATE=0.0045
# Frais de livraison forfaitaires (DZD) par commande.
DELIVERY_FEE_DZD=600

# ---- Stripe (mode test par défaut) ----
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- PayPal (sandbox par défaut) ----
# Clés sandbox : https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox
# ID du webhook PayPal (pour PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=

# ---- Base de données (chemin optionnel) ----
# DB_PATH=./data.db

# ---- E-mail (réinitialisation de mot de passe) ----
# SMTP utilisé pour envoyer le lien de réinitialisation. Sans SMTP, l'envoi est
# désactivé : en dev le lien est affiché dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
# Mets SMTP_SECURE=1 pour du TLS implicite (port 465) ; sinon STARTTLS (587).
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Durée de validité du lien de réinitialisation (heures).
RESET_TOKEN_TTL_HOURS=1

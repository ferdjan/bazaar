# ---- Serveur ----
PORT=3000
BASE_URL=http://localhost:3000

# ---- Sécurité session ----
# Génère une valeur aléatoire longue en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Compte admin semé (à changer après première connexion) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---- Devise ----
# 1 DZD = X EUR (taux indicatif : ~0.0045). Ajuste selon le taux réel.
DZD_TO_EUR_RATE=0.0045

# ---- Stripe (mode test par défaut) ----
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- PayPal (sandbox par défaut) ----
# Clés sandbox : https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# ---- Base de données (chemin optionnel) ----
# DB_PATH=./data.db

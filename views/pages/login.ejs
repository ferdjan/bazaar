<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container narrow">
  <h1><%= t('auth.login_title') %></h1>
  <% if (typeof error !== 'undefined') { %><div class="flash flash-error"><%= t(error) %></div><% } %>
  <form method="post" action="/connexion" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="email"><%= t('auth.email') %></label>
    <input id="email" type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
    <label for="password"><%= t('auth.password') %></label>
    <input id="password" type="password" name="password" required>
    <button type="submit" class="btn btn-primary block"><%= t('auth.login') %></button>
  </form>
  <p class="center"><%= t('auth.no_account') %> <a href="/inscription"><%= t('auth.register') %></a></p>
</main>
<%- include('../partials/footer') %>

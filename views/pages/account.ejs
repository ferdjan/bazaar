<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container">
  <h1><%= t('account.title') %></h1>
  <p class="muted"><%= user.name %> · <%= user.email %></p>
  <h2><%= t('account.orders') %></h2>
  <% if (!orders.length) { %>
    <p class="empty"><%= t('account.no_orders') %></p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th><%= t('order.ref') %></th>
          <th><%= t('order.date') %></th>
          <th><%= t('order.total') %></th>
          <th><%= t('order.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(o){ %>
          <tr>
            <td><%= o.ref %></td>
            <td><%= formatDate(o.created_at) %></td>
            <td><%= formatDzd(o.total_dzd) %></td>
            <td><%= t('status.' + o.status) %></td>
            <td><a href="/commande/<%= o.ref %>" class="btn btn-sm"><%= t('common.details') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('../partials/footer') %>

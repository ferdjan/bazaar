<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container narrow">
  <h1><%= t('auth.forgot_title') %></h1>
  <% if (typeof error !== 'undefined') { %><div class="flash flash-error"><%= t(error) %></div><% } %>
  <form method="post" action="/mot-de-passe-oublie" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="email"><%= t('auth.email') %></label>
    <input id="email" type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
    <button type="submit" class="btn btn-primary block"><%= t('auth.reset_send') %></button>
  </form>
  <p class="center"><a href="/connexion">← <%= t('common.back') %></a></p>
</main>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container narrow">
  <h1><%= t('auth.reset_title') %></h1>
  <% if (typeof error !== 'undefined') { %><div class="flash flash-error"><%= t(error) %></div><% } %>
  <form method="post" action="/reinitialiser/<%= token %>" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="password"><%= t('auth.password') %></label>
    <input id="password" type="password" name="password" minlength="6" required>
    <button type="submit" class="btn btn-primary block"><%= t('auth.reset_save') %></button>
  </form>
</main>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container">
  <a href="/catalogue" class="back">← <%= t('common.back') %></a>
  <div class="product-detail">
    <div class="product-media">
      <div class="product-img large" id="main-image">
        <% if (product.image) { %><img src="<%= product.image %>" alt="<%= pname(product) %>" id="main-image-img"><% } else { %><span class="placeholder" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5a2.1 2.1 0 1 0-2.1 2.1c.9 0 1.6.7 1.6 1.6V8"/><path d="m11.5 8-8 5.5A1.8 1.8 0 0 0 4.5 16.8h15a1.8 1.8 0 0 0 1-3.3L12.5 8"/></svg></span><% } %>
      </div>
      <% if (images && images.length) { %>
        <div class="product-gallery">
          <img src="<%= product.image %>" alt="<%= pname(product) %>" class="gallery-thumb active" data-src="<%= product.image %>" loading="lazy">
          <% images.forEach(function(im){ %><img src="<%= im.path %>" alt="<%= pname(product) %>" class="gallery-thumb" data-src="<%= im.path %>" loading="lazy"><% }) %>
        </div>
      <% } %>
    </div>
    <div class="product-info">
      <% if (cat) { %><span class="chip"><%= cname(cat) %></span><% } %>
      <h1><%= pname(product) %></h1>
      <p class="price big"><%= formatDzd(product.price_dzd) %></p>
      <p class="desc"><%= pdesc(product) %></p>
      <p class="stock <%= product.stock > 0 ? 'in' : 'out' %>">
        <%= product.stock > 0 ? t('product.stock') + ' (' + product.stock + ')' : t('product.out_of_stock') %>
      </p>
      <a href="#reviews" class="review-summary-link">
        <span class="review-summary-stars" aria-hidden="true">★★★★★</span>
        <span><%= t('review.title') %> (<%= reviewStats.count %>)</span>
      </a>
      <% if (product.stock > 0) { %>
        <% const sizes = (product.sizes || '').split(',').map(s => s.trim()).filter(Boolean); %>
        <form method="post" action="/panier/ajouter" class="add-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <% if (sizes.length) { %>
            <% if (sizes.length === 1) { %>
              <input type="hidden" name="size" value="<%= sizes[0] %>">
              <p class="size-picker"><span class="size-opt"><span><%= sizes[0] %></span></span></p>
            <% } else { %>
              <p class="muted"><%= t('product.size') %> :</p>
              <div class="size-picker">
                <% sizes.forEach(function(s){ %>
                  <label class="size-opt">
                    <input type="radio" name="size" value="<%= s %>" required>
                    <span><%= s %></span>
                  </label>
                <% }) %>
              </div>
            <% } %>
          <% } %>
          <div class="qty-stepper">
            <button type="button" class="qty-btn" data-step="-1" aria-label="-">&minus;</button>
            <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>" class="qty-input" inputmode="numeric" aria-label="<%= t('cart.qty') %>">
            <button type="button" class="qty-btn" data-step="1" aria-label="+">&plus;</button>
          </div>
          <button type="submit" class="btn btn-primary btn-add">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.3H8.7a1.5 1.5 0 0 1-1.5-1.3L6 8Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
            <%= t('product.add') %>
          </button>
          <% if (whatsappLink) { %>
            <a href="<%= whatsappLink %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-add"><%= t('product.whatsapp') %></a>
          <% } %>
        </form>
      <% } %>
    </div>
  </div>
  <% if (related.length) { %>
    <section class="section">
      <h2><%= t('product.related') %></h2>
      <div class="product-grid">
        <% related.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="section reviews-section" id="reviews">
    <h2><%= t('review.title') %> <% if (reviewStats.count) { %><span class="rating-badge">★ <%= reviewStats.avg %> (<%= reviewStats.count %>)</span><% } %></h2>

    <% if (reviews.length) { %>
      <ul class="review-list">
        <% reviews.forEach(function(r){ %>
          <li class="review-item">
            <div class="review-head">
              <span class="review-author"><%= r.author_name %></span>
              <span class="review-stars" aria-label="<%= r.rating %>/5"><% for (let s = 1; s <= 5; s++) { %><span class="star <%= s <= r.rating ? 'on' : '' %>">★</span><% } %></span>
              <span class="review-date"><%= formatDate(r.created_at) %></span>
            </div>
            <% if (r.comment) { %><p class="review-comment"><%= r.comment %></p><% } %>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty"><%= t('review.no_reviews') %></p>
    <% } %>

    <% if (canReview) { %>
      <form method="post" action="/produit/<%= product.slug %>/avis" class="review-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <h3><%= myReview ? t('review.your_review') : t('review.write') %></h3>
        <label><%= t('review.your_rating') %></label>
        <div class="star-input">
          <% for (let s = 5; s >= 1; s--) { %>
            <input type="radio" name="rating" id="star-<%= s %>" value="<%= s %>" <%= (myReview && myReview.rating === s) ? 'checked' : '' %> required>
            <label for="star-<%= s %>" title="<%= s %>">★</label>
          <% } %>
        </div>
        <label for="comment"><%= t('review.comment') %></label>
        <textarea id="comment" name="comment" rows="3"><%= myReview ? myReview.comment : '' %></textarea>
        <button type="submit" class="btn btn-primary"><%= t('review.submit') %></button>
      </form>
    <% } else if (!user) { %>
      <p class="muted"><a href="/connexion"><%= t('review.login') %></a></p>
    <% } else { %>
      <p class="muted"><%= t('review.must_order') %></p>
    <% } %>
  </section>
</main>
<script src="/js/product.js" defer></script>
<%- include('../partials/footer') %>

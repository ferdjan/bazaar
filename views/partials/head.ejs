<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' · Bazaar' : 'Bazaar · ' + t('brand.tagline') %></title>
  <meta name="description" content="<%= (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : t('seo.site_desc') %>">
  <link rel="canonical" href="<%= baseUrl %><%= path %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Bazaar' %>">
  <meta property="og:description" content="<%= (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : t('seo.site_desc') %>">
  <meta property="og:url" content="<%= baseUrl %><%= path %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;600;700&family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
</head>
<body>

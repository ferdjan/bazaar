<a href="/produit/<%= p.slug %>" class="product-card">
  <div class="product-img">
    <% if (p.image) { %><img src="<%= p.image %>" alt="<%= pname(p) %>" loading="lazy"><% } else { %><span class="placeholder" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5a2.1 2.1 0 1 0-2.1 2.1c.9 0 1.6.7 1.6 1.6V8"/><path d="m11.5 8-8 5.5A1.8 1.8 0 0 0 4.5 16.8h15a1.8 1.8 0 0 0 1-3.3L12.5 8"/></svg></span><% } %>
    <% if (p.stock === 0) { %>
      <span class="badge badge-low"><%= t('product.out_of_stock') %></span>
    <% } else if (p.stock > 0 && p.stock <= 5) { %>
      <span class="badge badge-low"><%= t('product.stock_limited') %></span>
    <% } %>
  </div>
  <div class="product-info">
    <h3><%= pname(p) %></h3>
    <p class="price"><%= formatDzd(p.price_dzd) %></p>
    <span class="tag-free"><%= t('product.shipping_flat') %></span>
  </div>
</a>

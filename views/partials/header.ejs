<div class="announce">
  <div class="container announce-inner"><%= t('announce.text') %></div>
</div>
<header class="site-header">
  <div class="container topbar">
    <a href="/" class="brand"><span class="brand-mark">B</span>azaar</a>
    <form method="get" action="/catalogue" class="nav-search" role="search">
      <input type="text" name="q" placeholder="<%= t('cat.search') %>" aria-label="<%= t('cat.search') %>">
      <button type="submit" class="btn btn-primary" aria-label="<%= t('cat.search_btn') %>">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
    </form>
    <div class="header-actions">
      <a href="/lang/<%= lang === 'ar' ? 'fr' : 'ar' %>" class="lang-switch"><%= t('lang.switch') %></a>
       <% if (user) { %>
         <a href="<%= isAdmin ? '/admin' : (isSeller ? '/scan' : '/compte') %>" class="icon-btn" aria-label="<%= isAdmin ? t('nav.admin') : (isSeller ? t('scan.title') : t('nav.account')) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.6-4 5-5.5 8-5.5s6.4 1.5 8 5.5"/></svg>
        </a>
        <form action="/deconnexion" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="link-btn"><%= t('nav.logout') %></button>
        </form>
      <% } else { %>
        <a href="/connexion" class="lang-switch"><%= t('nav.login') %></a>
        <a href="/inscription" class="btn btn-primary btn-sm"><%= t('nav.register') %></a>
      <% } %>
       <% if (!isAdmin && !isSeller) { %>
        <a href="/panier" class="icon-btn" aria-label="<%= t('nav.cart') %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.3H8.7a1.5 1.5 0 0 1-1.5-1.3L6 8Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
          <span class="cart-count"><%= cartCount %></span>
        </a>
      <% } %>
    </div>
  </div>
  <nav class="nav-cats">
    <div class="container nav-cats-inner">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav.home') %></a>
      <a href="/catalogue" class="<%= path === '/catalogue' || (typeof path !== 'undefined' && path.startsWith('/produit')) ? 'active' : '' %>"><%= t('nav.catalog') %></a>
      <% categories.forEach(function(c){ %>
        <a href="/catalogue?categorie=<%= c.id %>"><%= cname(c) %></a>
      <% }) %>
    </div>
  </nav>
</header>
<% if (flash) { %>
  <div class="container">
    <div class="flash flash-<%= flash.type %>"><%= t(flash.key) %></div>
  </div>
<% } %>

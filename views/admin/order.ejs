<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>
<main class="container narrow">
  <a href="/admin/commandes" class="back">← <%= t('common.back') %></a>
  <h1><%= t('order.details') %> — <%= order.ref %></h1>

  <p><%= t('admin.customer') %> : <strong><%= order.nom %></strong></p>
  <p><%= t('auth.email') %> : <%= order.email %></p>
  <p><%= t('auth.phone') %> : <%= order.telephone %></p>
  <p><%= t('checkout.address') %> : <%= order.adresse %>, <%= order.ville %></p>
  <% if (order.wilaya_code) { %><p><%= t('checkout.wilaya') %> : <strong><%= L(order.wilaya_name_fr, order.wilaya_name_ar) %></strong></p><% } %>
  <% if (order.commune_id) { %><p><%= t('checkout.commune') %> : <strong><%= L(order.commune_name_fr, order.commune_name_ar) %></strong></p><% } %>
  <p><%= t('order.payment') %> : <%= t('pay.' + order.payment_method) %> — <%= order.refund_dzd > 0 ? t('pay.refunded') : t('pay.' + order.payment_status) %></p>
  <% if (order.delivery_status !== 'pending') { %><p><%= t('order.delivery') %> : <strong><%= t('delivery.' + order.delivery_status) %></strong></p><% } %>

  <table class="table">
    <thead>
      <tr><th><%= t('cart.product') %></th><th><%= t('cart.qty') %></th><th><%= t('cart.price') %></th></tr>
    </thead>
    <tbody>
      <% order.items.forEach(function(it){ %>
        <tr><td><%= it.name %><% if (it.size) { %> <span class="chip"><%= it.size %></span><% } %></td><td><%= it.qty %></td><td><%= formatDzd(it.price_dzd) %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <p class="line"><%= t('cart.subtotal') %> : <strong><%= formatDzd(order.total_dzd - order.delivery_dzd) %></strong></p>
  <p class="line"><%= t('cart.shipping') %> : <strong><%= formatDzd(order.delivery_dzd) %></strong></p>
  <p class="total"><%= t('order.total') %> : <strong><%= formatDzd(order.total_dzd) %></strong></p>

  <%- include('../partials/order-tracking') %>

  <section class="admin-actions">
    <h2><%= t('admin.actions') %></h2>
    <div class="actions">
      <% if (order.status === 'payee' || (order.status === 'en_attente' && order.payment_method === 'cod')) { %>
        <form method="post" action="/admin/commandes/<%= order.ref %>/action" class="action-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="ship">
          <input type="text" name="carrier" maxlength="100" placeholder="<%= t('tracking.carrier') %>">
          <input type="text" name="tracking_number" maxlength="100" placeholder="<%= t('tracking.number') %>">
          <button type="submit" class="btn btn-primary"><%= t('admin.ship') %></button>
        </form>
      <% } %>
      <% if (order.status === 'expediee') { %>
        <form method="post" action="/admin/commandes/<%= order.ref %>/action">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="deliver">
          <button type="submit" class="btn btn-primary"><%= t('admin.deliver') %></button>
        </form>
      <% } %>
      <% if (order.status !== 'annulee') { %>
        <form method="post" action="/admin/commandes/<%= order.ref %>/action" onsubmit="return confirm('<%= t('admin.confirm_cancel') %>');">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="cancel">
          <button type="submit" class="btn btn-danger"><%= t('admin.cancel_order') %></button>
        </form>
      <% } %>
    </div>
  </section>

  <section class="admin-actions">
    <h2><%= t('admin.delivery_issue') %></h2>
    <form method="post" action="/admin/commandes/<%= order.ref %>/incident" class="action-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <select name="issue">
        <option value="failed"><%= t('admin.issue_failed') %></option>
        <option value="damaged"><%= t('admin.issue_damaged') %></option>
        <option value="returning"><%= t('admin.issue_returning') %></option>
        <option value="returned"><%= t('admin.issue_returned') %></option>
      </select>
      <button type="submit" class="btn"><%= t('admin.save_incident') %></button>
    </form>
    <% if (order.delivery_status === 'returned') { %>
      <form method="post" action="/admin/commandes/<%= order.ref %>/retour" class="action-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <select name="condition">
          <option value="resellable"><%= t('admin.return_resellable') %></option>
          <option value="damaged"><%= t('admin.return_damaged') %></option>
        </select>
        <button type="submit" class="btn btn-primary"><%= t('admin.process_return') %></button>
      </form>
    <% } %>
  </section>

  <section class="admin-actions">
    <h2><%= t('admin.label') %></h2>
    <p class="muted"><%= t('admin.label_hint') %></p>
    <form method="post" action="/admin/commandes/<%= order.ref %>/etiquette">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-primary"><%= t('admin.generate_label') %></button>
    </form>
  </section>

  <form method="post" action="/admin/commandes/<%= order.ref %>/statut" class="filters">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <select name="status">
      <% ['en_attente','expediee','livree','annulee'].forEach(function(s){ %>
        <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= t('status.' + s) %></option>
      <% }) %>
    </select>
    <input type="text" name="carrier" placeholder="<%= t('tracking.carrier') %>" value="<%= order.carrier %>">
    <input type="text" name="tracking_number" placeholder="<%= t('tracking.number') %>" value="<%= order.tracking_number %>">
    <button type="submit" class="btn"><%= t('admin.save') %></button>
  </form>

  <section class="admin-history">
    <h2><%= t('admin.history') %></h2>
    <% if (!history.length) { %>
      <p class="empty"><%= t('admin.no_history') %></p>
    <% } else { %>
      <table class="table">
        <thead><tr><th><%= t('order.date') %></th><th><%= t('admin.actions') %></th><th><%= t('order.status') %></th><th><%= t('admin.customer') %></th></tr></thead>
        <tbody>
          <% history.forEach(function(event) { %>
            <tr>
              <td><%= formatDate(event.created_at) %></td>
              <td><%= t('admin.history.' + event.action) %></td>
              <td><%= event.from_status ? t('status.' + event.from_status) + ' → ' : '' %><%= t('status.' + event.to_status) %></td>
              <td><%= event.actor_name || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>
<%- include('../partials/footer') %>
